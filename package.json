{
  "name": "cordova-sqlite-file",
  "version": "7.0.1-dev",
  "description": "Native interface to SQLite for PhoneGap / Cordova - cordova-sqlite-file plugin version",
  "cordova": {
    "id": "cordova-sqlite-file",
    "platforms": [
      "android",
      "electron",
      "ios"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xpbrew/cordova-sqlite-storage.git"
  },
  "keywords": [
    "sqlite",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-electron"
  ],
  "author": "various",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xpbrew/cordova-sqlite-storage/issues"
  },
  "homepage": "https://github.com/xpbrew/cordova-sqlite-storage",
  "engines": {
    "cordovaDependencies": {
      "5.0.0": {
        "cordova-android": ">=6.3.0"
      },
      "7.0.0": {
        "cordova-android": ">=10.0.0"
      },
      "8.0.0": {
        "cordova-electron": ">=3.0.0",
        "cordova-android": ">=12.0.0"
      },
      "9.0.0": {
        "cordova-electron": ">=4.0.0",
        "cordova": ">100"
      }
    }
  },
  "dependencies": {
    "cordova-sqlite-storage-dependencies": "5.0.0"
  },
  "scripts": {
    "clean-spec": "rimraf spec/[mnp]* && git checkout -- spec/config.xml spec/package.json && git status --ignored",
    "prepare-js": "coffee -p SQLitePlugin.coffee.md > www/SQLitePlugin.js",
    "prepare-spec": "node scripts/prepareSpec.js"
  },
  "devDependencies": {
    "coffeescript": "1",
    "cross-spawn": "^6.0.5",
    "fs-extra": "^8.1.0",
    "rimraf": "^3.0.2",
    "execa": "^5.1.1"
  }
}
